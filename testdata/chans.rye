example: import\go "example.com"

do\in example {
    ch: Get1And2
    print ch .Read
    print ch .Read

    done: channel 0

    Printer done
        |Send 10
        |Send 20
        |Close
    done .Read

    dch: Doubler done
    dch .Send 15
    print dch .Read
    dch .Send 35
    print dch .Read
    dch .Close
    done .Read

    pch: channel 0
    ; A completion signal keeps the goroutine's output deterministic in the test.
    printed: channel 0
    go does { PrintChan pch printed .Send nil }
    pch
        |Send 9
        |Send 8
        |Send 7
        |Close
    ; Wait until PrintChan consumes the values before checking error output.
    printed .Read

    try {
        Printer done
            |Send "abc"
            |Close
        done .Read
    }
}