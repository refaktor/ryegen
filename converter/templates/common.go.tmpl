{{ define "defTranslateChan" }}
{{- $name := printf "translateChan_%v" (typHash .) -}}
{{- if once $name -}}
func {{ $name }}(ps *_env.ProgramState, ctx *_env.RyeCtx, goCh {{ typStr . }}, ryeCh chan *_env.Object) {
    fail := func(err error) {
        ps.FailureFlag = true
        // Propagate as a Rye error object into the channel to be handled upstream.
        e := _env.NewError("channel(" + {{ typStr .Elem | quote }} + ") conversion error: " + err.Error())
        obj := _env.Object(e)
        select {
        case ryeCh <- &obj:
        default:
            // Best effort; if receiver isn't listening, we still set FailureFlag.
        }
    }
    for {
        select {
        case v, ok := <-ryeCh:
            if !ok {
                {{- if chanCanSend . }}
                close(goCh)
                {{- end }}
                return
            }
            {{ if chanCanSend . -}}
            ov, err := {{ conv .Elem fromRye }}(ps, ctx, *v)
            if err != nil {
                fail(err)
                continue
            }
            goCh <- ov
            {{- else -}}
            _ = v
            fail(_errors.New("attempt to send to read-only Rye channel"))
            {{- end }}
        {{- if chanCanRecv . }}
        case v, ok := <-goCh:
            if !ok {
                close(ryeCh)
                return
            }
            ov, err := {{ conv .Elem toRye }}(ps, ctx, v)
            if err != nil {
                fail(err)
                continue
            }
            ovObj := _env.Object(ov)
            ryeCh <- &ovObj
        {{- end }}
        }
    }
}

{{ end }}
{{- end }}